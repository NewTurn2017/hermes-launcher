{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hermes Launcher",
  "version": "0.1.0",
  "identifier": "research.nous.hermes-launcher",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hermes Launcher",
        "width": 720,
        "height": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico"]
  }
}
